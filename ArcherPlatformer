#  MATH PROBLEM GENERATOR
# ═══════════════════════════════════════════════════════════════════
def gen_problem(difficulty: int):
    types = {
        1: ['add', 'sub', 'mul', 'double', 'half', 'fib', 'arith_seq'],
        2: ['add', 'sub', 'mul', 'div', 'double', 'half', 'percent', 'fib', 'arith_seq'],
        3: ['mul', 'div', 'algebra', 'add', 'percent', 'square', 'mean', 'fib', 'arith_seq'],
        4: ['algebra', 'mul', 'div', 'percent', 'square', 'cube', 'mean', 'remainder', 'fib', 'arith_seq'],
    }
    kind = random.choice(types.get(difficulty, types[4]))
    if kind == 'add':
        a = random.randint(8 * difficulty, 40 * difficulty)
        b = random.randint(8 * difficulty, 40 * difficulty)
        return f"{a} + {b} = ?", a + b
    elif kind == 'sub':
        a = random.randint(15 * difficulty, 50 * difficulty)
        b = random.randint(3, a - 1)
        return f"{a} - {b} = ?", a - b
    elif kind == 'mul':
        a = random.randint(2, 4 + difficulty * 3)
        b = random.randint(2, 4 + difficulty * 3)
        return f"{a} x {b} = ?", a * b
    elif kind == 'div':
        divisor = random.randint(2, 3 + difficulty * 2)
        answer = random.randint(2, 6 + difficulty * 3)
        return f"{divisor * answer} / {divisor} = ?", answer
    elif kind == 'algebra':
        coeff = random.randint(2, 2 + difficulty)
        x_val = random.randint(1, 4 + difficulty * 2)
        const = random.randint(1, 8 + difficulty * 3)
        return f"Solve: {coeff}x + {const} = {coeff * x_val + const}", x_val
    elif kind == 'percent':
        pct = random.choice([10, 20, 25, 50, 75])
        base = random.choice([40, 60, 80, 100, 120, 200, 400])
        return f"{pct}% of {base} = ?", int(base * pct / 100)
    elif kind == 'fib':
        seq_len = random.randint(4 + difficulty, 6 + difficulty)
        seq = [1, 1]
        while len(seq) < seq_len:
            seq.append(seq[-1] + seq[-2])
        shown = ", ".join(str(v) for v in seq[-4:])
        return f"Next in Fibonacci: {shown}, ?", seq[-1] + seq[-2]
    elif kind == 'double':
        a = random.randint(3 * difficulty, 25 * difficulty)
        return f"Double of {a} = ?", a * 2
    elif kind == 'half':
        ans = random.randint(2 * difficulty, 20 * difficulty)
        return f"Half of {ans * 2} = ?", ans
    elif kind == 'square':
        a = random.randint(2, 4 + difficulty * 2)
        return f"{a}^2 = ?", a * a
    elif kind == 'cube':
        a = random.randint(2, 2 + difficulty)
        return f"{a}^3 = ?", a * a * a
    elif kind == 'mean':
        a = random.randint(6, 20 + difficulty * 4)
        b = random.randint(6, 20 + difficulty * 4)
        if (a + b) % 2 == 1:
            b += 1
        return f"Mean of {a} and {b} = ?", (a + b) // 2
    elif kind == 'remainder':
        divisor = random.randint(3, 4 + difficulty)
        quotient = random.randint(2, 4 + difficulty)
        rem = random.randint(1, divisor - 1)
        n = divisor * quotient + rem
        return f"Remainder: {n} mod {divisor} = ?", rem
    elif kind == 'arith_seq':
        start = random.randint(1, 10 + difficulty * 2)
        step = random.randint(2, 3 + difficulty)
        seq = [start + i * step for i in range(4)]
        return f"Next in sequence: {seq[0]}, {seq[1]}, {seq[2]}, {seq[3]}, ?", seq[3] + step
    a, b = random.randint(5, 25), random.randint(5, 25)
    return f"{a} + {b} = ?", a + b


def gen_wrong(correct, n=4, spread=8):
    wrong = set()
    att = 0
    while len(wrong) < n and att < 300:
        att += 1
        off = random.randint(1, spread)
        if random.random() < 0.5:
            off = -off
        v = correct + off
        if v != correct and v >= 0 and v not in wrong:
            wrong.add(v)
    while len(wrong) < n:
        wrong.add(correct + len(wrong) + 1)
    return list(wrong)[:n]


