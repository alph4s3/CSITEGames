LB_FILE = "leaderboardAP.json"
MAX_LB  = 10


def load_leaderboard() -> list:
    """Load leaderboard from JSON. Returns sorted list of {name, time, dnf}."""
    if os.path.exists(LB_FILE):
        try:
            with open(LB_FILE, "r") as f:
                data = json.load(f)
            if isinstance(data, list):
                cleaned = []
                for e in data:
                    if not isinstance(e, dict):
                        continue
                    name = str(e.get("name", "ANON"))[:12]
                    # Backward-compatible parsing for old score-only entries.
                    if "time" in e:
                        t = float(e.get("time", 9999.0))
                    elif "score" in e:
                        t = 9999.0
                    else:
                        continue
                    cleaned.append({"name": name, "time": round(t, 2), "dnf": bool(e.get("dnf", False))})
                cleaned.sort(key=lambda row: (row.get("dnf", False), row.get("time", 9999.0)))
                return cleaned[:MAX_LB]
        except (json.JSONDecodeError, IOError):
            pass
    return []


def save_leaderboard(board: list):
    """Save leaderboard list to JSON file."""
    try:
        with open(LB_FILE, "w") as f:
            json.dump(board[:MAX_LB], f, indent=2)
    except IOError:
        pass


def add_to_leaderboard(name: str, time_sec: float, dnf: bool = False) -> Tuple[list, bool]:
    """Add entry. Returns (updated_board, made_top_10)."""
    board = load_leaderboard()
    entry = {"name": name[:12], "time": round(float(time_sec), 2), "dnf": bool(dnf)}
    board.append(entry)
    board.sort(key=lambda e: (e.get("dnf", False), e.get("time", 9999.0)))
    board = board[:MAX_LB]
    save_leaderboard(board)
    is_high = entry in board
    return board, is_high


