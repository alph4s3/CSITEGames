def lerp(a, b, t):
    return a + (b - a) * t


def txt_c(surf, text, font, color, y, x=None):
    r = font.render(text, True, color)
    cx = (x if x is not None else WIDTH // 2) - r.get_width() // 2
    surf.blit(r, (cx, y - r.get_height() // 2))
    return r


def txt_sh(surf, text, font, color, y, x=None):
    sc = tuple(max(0, c // 5) for c in color)
    txt_c(surf, text, font, sc, y + 2, x)
    txt_c(surf, text, font, color, y, x)


def _draw_vertical_gradient(surf, top, bottom):
    h = surf.get_height()
    w = surf.get_width()
    for y in range(h):
        t = y / max(1, h - 1)
        c = (
            int(lerp(top[0], bottom[0], t)),
            int(lerp(top[1], bottom[1], t)),
            int(lerp(top[2], bottom[2], t)),
        )
        pygame.draw.line(surf, c, (0, y), (w, y))


def _build_mountain_layer(w, h, base_y, color_lo, color_hi, seed=1, step=70):
    rng = random.Random(seed)
    layer = pygame.Surface((w, h), pygame.SRCALPHA)
    pts = [(-60, h)]
    x = -40
    while x <= w + 40:
        peak = rng.randint(base_y - 120, base_y + 35)
        pts.append((x, peak))
        x += step + rng.randint(-18, 18)
    pts.extend([(w + 60, h), (-60, h)])
    pygame.draw.polygon(layer, (*color_lo, 220), pts)
    # Soft highlight ridge for cel-shaded look
    ridge = []
    for px, py in pts[1:-2]:
        ridge.append((px, py + 8))
    if len(ridge) > 2:
        pygame.draw.lines(layer, (*color_hi, 140), False, ridge, 3)
    return layer


def _build_pixel_vibe_overlay(w, h):
    overlay = pygame.Surface((w, h), pygame.SRCALPHA)
    # Stronger scanlines and pixel grid for a visible retro feel.
    for y in range(0, h, 2):
        pygame.draw.line(overlay, (0, 0, 0, 48), (0, y), (w, y))
    for y in range(1, h, 4):
        pygame.draw.line(overlay, (0, 0, 0, 28), (0, y), (w, y))
    for x in range(0, w, 3):
        pygame.draw.line(overlay, (0, 0, 0, 14), (x, 0), (x, h))
    # Add a faint vertical metro accent every 48 pixels for a stronger 'metro' feel.
    for x in range(0, w, 48):
        pygame.draw.line(overlay, (10, 20, 24, 24), (x, 0), (x, h), 2)
    # Highlight speckles in a checker rhythm for a pixel-grid feel.
    for y in range(0, h, 4):
        x_start = (y // 4) % 2
        for x in range(x_start, w, 4):
            overlay.set_at((x, y), (255, 255, 255, 26))
    return overlay


