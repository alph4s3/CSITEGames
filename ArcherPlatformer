#  LEADERBOARD PANEL DRAWER
# ═══════════════════════════════════════════════════════════════════
def draw_lb_panel(surf, board, cx, top_y, title="TOP 10 SCORES",
                  hl_name=None, hl_score=None, pw=380, rh=22):
    """Draw a styled leaderboard panel centered at cx."""
    n = len(board)
    hdr_h = 36
    col_hdr_h = 18
    body_h = max(rh * max(n, 1) + col_hdr_h + 12, 50)
    total_h = hdr_h + body_h
    px = cx - pw // 2
    py = top_y

    # Panel background + border
    pygame.draw.rect(surf, PANEL_BG, (px, py, pw, total_h), border_radius=8)
    pygame.draw.rect(surf, PANEL_BORDER, (px, py, pw, total_h), 2, border_radius=8)

    # Header bar
    pygame.draw.rect(surf, GREY_DARK, (px + 2, py + 2, pw - 4, hdr_h - 2),
                     border_radius=6)
    ht = FONT_LB_HDR.render(title, True, GOLD)
    surf.blit(ht, (cx - ht.get_width() // 2, py + hdr_h // 2 - ht.get_height() // 2))

    # Body
    ry = py + hdr_h + 4
    if n == 0:
        et = FONT_LB.render("No scores yet!", True, GREY)
        surf.blit(et, (cx - et.get_width() // 2, ry + 10))
        return

    # Column headers
    for text, xoff in [("#", 14), ("NAME", 50), ("TIME", pw - 110)]:
        ct = FONT_XS.render(text, True, GREY)
        surf.blit(ct, (px + xoff, ry))
    ry += col_hdr_h

    rank_colors = [GOLD, (200, 200, 210), ORANGE]
    for i, entry in enumerate(board):
        name = entry.get("name", "???")
        score = float(entry.get("time", 9999.0))
        is_dnf = bool(entry.get("dnf", False))
        is_hl = (hl_name and hl_score is not None
                 and name == hl_name and score == hl_score)
        if is_hl:
            pygame.draw.rect(surf, (50, 40, 80),
                             (px + 4, ry - 1, pw - 8, rh), border_radius=3)
        rc = rank_colors[i] if i < 3 else GREY
        nc = WHITE if is_hl else (200, 200, 210)
        sc_c = GOLD if is_hl else (180, 180, 190)
        for text, col, xoff in [(f"{i+1}.", rc, 14), (name[:12], nc, 50)]:
            rt = FONT_LB.render(text, True, col)
            surf.blit(rt, (px + xoff, ry))
        score_text = "DNF" if is_dnf else f"{score:.2f}s"
        st = FONT_LB.render(score_text, True, sc_c)
        surf.blit(st, (px + pw - 16 - st.get_width(), ry))
        ry += rh


# ═══════════════════════════════════════════════════════════════════
#  GAME CLASS — full state machine
# ═══════════════════════════════════════════════════════════════════
class Game:
    TITLE      = 0
    INTRO      = 1
    PLAYING    = 2
    LEVEL_DONE = 3
    OVER       = 4
    WIN        = 5
    NAME_ENTRY = 6
    LB_SCREEN  = 7

    def __init__(self):
        self.state = self.TITLE
        self.score = 0
        self.time_penalty_ms = 0
        self.level_start_ticks = 0
        self.elapsed_ms = 0
        self.lives = 3
        self.lvl = 0
        self.player: Optional[Player] = None
        self.arrows: List[Arrow] = []
        self.targets: List[Target] = []
        self.question = ""
        self.answer = 0
        self.solved = 0
        self.n_prob = 0
        self.intro_t = 0
        self.done_t = 0
        self.shake = Shake()
        self.flash_txt = ""
        self.flash_col = WHITE
        self.flash_t = 0
        self.frame = 0
        # Name entry / leaderboard
        self.name_input = ""
        self.name_max = 12
        self.final_score = 0
        self.final_time = 0.0
        self.final_dnf = False
        self.came_from_win = False
        self.lb_board: list = []
        self.lb_is_high = False
        self.show_timer = 0
        self.title_lb = load_leaderboard()
        g_parts.clear()

    def full_reset(self):
        self.__init__()

    def start_level(self):
        lv = LEVELS[self.lvl]
        self.state = self.INTRO
        self.intro_t = 160
        px, py = lv['spawn']
        self.player = Player(px, py)
        self.arrows.clear()
        self.targets.clear()
        self.solved = 0
        self.n_prob = lv['n_problems']
        self.time_penalty_ms = 0
        self.elapsed_ms = 0
        self.level_start_ticks = pygame.time.get_ticks()
        g_parts.clear()
        self._next_q()

    def _next_q(self):
        lv = LEVELS[self.lvl]
        q, a = gen_problem(lv['difficulty'])
        self.question = q
        self.answer = a
        self.targets.clear()
        zones = list(lv['zones'])
        random.shuffle(zones)
        wrongs = gen_wrong(a, 4, 5 + lv['difficulty'] * 2)
        ci = random.randint(0, 4)
        mt = lv.get('moving_targets', False)
        for i in range(5):
            x, y = zones[i % len(zones)]
            is_c = (i == ci)
            val = a if is_c else wrongs.pop(0)
            mv = mt and random.random() < 0.45
            self.targets.append(Target(
                x, y, val, correct=is_c, moving=mv,
                move_range=random.randint(25, 55) if mv else 0,
                move_speed=random.uniform(0.9, 1.6) if mv else 0))

    def flash(self, txt, col, dur=80):
        self.flash_txt = txt
        self.flash_col = col
        self.flash_t = dur

    def _go_name_entry(self, from_win):
        self.state = self.NAME_ENTRY
        self.final_score = self.score
        self.final_time = self.elapsed_ms / 1000.0
        self.final_dnf = not from_win
        self.came_from_win = from_win
        self.name_input = ""

    def _submit_name(self):
        name = self.name_input.strip() or "ANON"
        self.lb_board, self.lb_is_high = add_to_leaderboard(name, self.final_time, self.final_dnf)
        self.state = self.LB_SCREEN

    # ─── UPDATE ──────────────────────────────────────────────
    def update(self):
        self.frame += 1

        if self.state == self.INTRO:
            self.intro_t -= 1
            if self.intro_t <= 0:
                self.state = self.PLAYING
            return

        if self.state == self.LEVEL_DONE:
            self.done_t -= 1
            if self.frame % 4 == 0:
                emit(random.randint(200, WIDTH - 200), random.randint(120, 300),
                     random.choice([GOLD, GREEN, CYAN, PINK]), n=4, speed=3, life=30, size=4)
            self._tick_p()
            if self.done_t <= 0:
                self.lvl += 1
                if self.lvl >= len(LEVELS):
                    self.state = self.WIN
                    self.show_timer = 200
                else:
                    self.start_level()
            return

        if self.state == self.OVER:
            self.show_timer -= 1
            self._tick_p()
            if self.show_timer <= 0:
                self._go_name_entry(False)
            return

        if self.state == self.WIN:
            self.show_timer -= 1
            if self.frame % 3 == 0:
                emit(random.randint(150, WIDTH - 150), random.randint(100, 350),
                     random.choice([GOLD, GREEN, CYAN, PINK, ORANGE]),
                     n=3, speed=3, life=35, size=4)
            self._tick_p()
            if self.show_timer <= 0:
                self._go_name_entry(True)
            return

        if self.state in (self.TITLE, self.NAME_ENTRY, self.LB_SCREEN):
            self._tick_p()
            return

        if self.state != self.PLAYING:
            return

        # ── PLAYING ──
        keys = pygame.key.get_pressed()
        lv = LEVELS[self.lvl]
        self.elapsed_ms = pygame.time.get_ticks() - self.level_start_ticks + self.time_penalty_ms
        for pl in lv['platforms']:
            pl.update()
        self.player.update(keys, lv['platforms'])
        mx, my = pygame.mouse.get_pos()
        self.player.aim_at(mx, my)

        wind = lv.get('wind', 0.0)
        for arr in self.arrows:
            arr.update(lv['platforms'])
            if arr.alive:
                for tgt in self.targets:
                    if tgt.alive and tgt.hit_anim == 0 and arr.hitbox.colliderect(tgt.hitbox):
                        arr.alive = False
                        tgt.hit_anim = 25
                        emit(tgt.x, tgt.y, GOLD, n=20, speed=5, life=30, size=3.5)
                        if tgt.correct:
                            self.solved += 1
                            self.flash("CORRECT!", GREEN, 60)
                            emit_text(tgt.x, tgt.y - 20, "CORRECT!", GREEN)
                            sfx(SFX_OK)
                        else:
                            self.time_penalty_ms += 3000
                            self.player.slow_timer = 90
                            self.shake.trigger(16, 7)
                            self.flash("+3s  WRONG!", RED, 60)
                            emit_text(tgt.x, tgt.y - 20, "WRONG", RED)
                            emit(tgt.x, tgt.y, RED, n=12, speed=4, life=22)
                            sfx(SFX_BAD)
                            self.lives -= 1
                            if self.lives <= 0:
                                self.state = self.OVER
                                self.show_timer = 180
                                return
                        break
        self.arrows = [a for a in self.arrows if a.alive]
        for t in self.targets:
            t.update()
        ct = [t for t in self.targets if t.correct]
        if ct and not ct[0].alive:
            if self.solved >= self.n_prob:
                self.state = self.LEVEL_DONE
                self.done_t = 150
                self.flash("TIME TRIAL COMPLETE!", GOLD, 100)
                sfx(SFX_LVL)
            else:
                self._next_q()
        self._tick_p()
        if self.flash_t > 0:
            self.flash_t -= 1

    def _tick_p(self):
        for p in g_parts:
            p.update()
        g_parts[:] = [p for p in g_parts if p.life > 0]

    # ─── EVENTS ──────────────────────────────────────────────
    def handle(self, ev) -> bool:
        if ev.type == pygame.QUIT:
            return False
        if ev.type == pygame.KEYDOWN and ev.key == pygame.K_ESCAPE:
            if self.state in (self.LB_SCREEN, self.NAME_ENTRY):
                self.full_reset()
                return True
            return False

        if self.state == self.TITLE:
            if ev.type == pygame.KEYDOWN and ev.key in (pygame.K_RETURN, pygame.K_SPACE):
                self.score = 0
                self.lives = 3
                self.lvl = 0
                self.start_level()
            return True

        if self.state == self.NAME_ENTRY:
            if ev.type == pygame.KEYDOWN:
                if ev.key == pygame.K_RETURN:
                    self._submit_name()
                    sfx(SFX_LVL)
                elif ev.key == pygame.K_BACKSPACE:
                    self.name_input = self.name_input[:-1]
                    sfx(SFX_TYPE)
                else:
                    ch = ev.unicode
                    if ch and ch.isprintable() and len(self.name_input) < self.name_max:
                        self.name_input += ch
                        sfx(SFX_TYPE)
            return True

        if self.state == self.LB_SCREEN:
            if ev.type == pygame.KEYDOWN and ev.key in (pygame.K_RETURN, pygame.K_SPACE):
                self.full_reset()
            return True

        if self.state in (self.OVER, self.WIN):
            if ev.type == pygame.KEYDOWN and ev.key in (pygame.K_RETURN, pygame.K_SPACE):
                self.show_timer = 0
            return True

        if self.state == self.PLAYING:
            if ev.type == pygame.KEYDOWN:
                if ev.key in (pygame.K_SPACE, pygame.K_w, pygame.K_UP):
                    self.player.jump()
                if ev.key == pygame.K_r:
                    self.start_level()
            if ev.type == pygame.MOUSEBUTTONDOWN and ev.button == 1:
                self.player.charging = True
                self.player.charge = 0
            if ev.type == pygame.MOUSEBUTTONUP and ev.button == 1 and self.player.charging:
                wind = LEVELS[self.lvl].get('wind', 0.0)
                arr = self.player.shoot(wind)
                if arr:
                    if len(self.arrows) >= MAX_ARROWS:
                        self.arrows.pop(0)
                    self.arrows.append(arr)
        return True

    # ─── DRAW ────────────────────────────────────────────────
    def draw(self):
        cam_x = self.player.cx if self.player else 0
        draw_fantasy_background(screen, self.frame, cam_x)
        sx, sy = self.shake.offset()
        {
            self.TITLE:      self._d_title,
            self.INTRO:      self._d_intro,
            self.PLAYING:    lambda: self._d_game(sx, sy),
            self.LEVEL_DONE: self._d_lvl_done,
            self.OVER:       self._d_over,
            self.WIN:        self._d_win,
            self.NAME_ENTRY: self._d_name,
            self.LB_SCREEN:  self._d_lb,
        }.get(self.state, lambda: None)()

    def _d_title(self):
        txt_sh(screen, "MATH ARCHER", FONT_XL, GOLD, 65)
        # Bow decoration
        cx, cy = WIDTH // 2, 128
        prev = None
        for i in range(12):
            a = -0.8 + 1.6 * (i / 11)
            bx = int(cx + math.cos(a - math.pi / 2) * 28)
            by = int(cy + math.sin(a - math.pi / 2) * 28)
            if prev:
                pygame.draw.line(screen, BROWN, prev, (bx, by), 3)
            prev = (bx, by)
        p0 = (int(cx + math.cos(-0.8 - math.pi / 2) * 28),
              int(cy + math.sin(-0.8 - math.pi / 2) * 28))
        p1 = (int(cx + math.cos(0.8 - math.pi / 2) * 28),
              int(cy + math.sin(0.8 - math.pi / 2) * 28))
        pygame.draw.line(screen, WHITE, p0, p1, 1)
        pygame.draw.line(screen, BROWN_LIGHT, (cx, cy - 38), (cx, cy - 14), 3)
        pygame.draw.polygon(screen, WHITE, [(cx, cy - 43), (cx - 4, cx - 33), (cx + 4, cy - 33)])
        # Start prompt
        pulse = int(200 + 55 * math.sin(self.frame * 0.06))
        txt_c(screen, "Press SPACE to Start", FONT_SM,
              (pulse, pulse, min(255, pulse + 20)), 170)
        txt_c(screen, "A/D: Move | SPACE: Jump | Click: Shoot", FONT_XS, GREY, 193)
        # Leaderboard
        draw_lb_panel(screen, self.title_lb, WIDTH // 2, 215,
                      title="TOP 10 TIMES", pw=380, rh=22)

    def _d_intro(self):
        lv = LEVELS[self.lvl]
        txt_sh(screen, f"LEVEL {self.lvl + 1}", FONT_LG, GOLD, 175)
        txt_sh(screen, lv['name'], FONT_MD, WHITE, 220)
        stars = "* " * lv['difficulty'] + ". " * (4 - lv['difficulty'])
        txt_c(screen, f"Difficulty: {stars.strip()}", FONT_SM, ORANGE, 265)
        txt_c(screen, f"Questions: {lv['n_problems']}", FONT_SM, GREY, 293)
        if lv['wind'] > 0:
            txt_c(screen, "Wind active!", FONT_SM, CYAN, 323)
        if lv.get('moving_targets'):
            txt_c(screen, "Targets may move!", FONT_SM, PINK, 348)
        frac = 1.0 - self.intro_t / 160
        bw = 220
        bx = WIDTH // 2 - bw // 2
        pygame.draw.rect(screen, GREY_DIM, (bx, 400, bw, 8), border_radius=4)
        pygame.draw.rect(screen, GOLD, (bx, 400, int(bw * frac), 8), border_radius=4)

    def _d_game(self, sx, sy):
        gs = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
        draw_fantasy_background(gs, self.frame, self.player.cx)
        lv = LEVELS[self.lvl]
        mx, my = pygame.mouse.get_pos()
        for pl in lv['platforms']:
            pl.draw(gs)
        for tgt in self.targets:
            tgt.draw(gs)
        for arr in self.arrows:
            arr.draw(gs)
        self.player.draw(gs, mx, my)
        for p in g_parts:
            p.draw(gs)
        if lv['wind'] > 0:
            wy = HEIGHT - 18
            for i in range(4):
                wx = WIDTH - 120 + i * 20 + int(math.sin(self.frame * 0.1 + i) * 3)
                ca = 100 + i * 30
                pygame.draw.lines(gs, (ca, ca, 255), False,
                                  [(wx, wy - 4), (wx + 6, wy), (wx, wy + 4)], 2)
            wt = FONT_XS.render("WIND", True, (120, 150, 255))
            gs.blit(wt, (WIDTH - 175, wy - 8))
        apply_pixel_vibe_overlay(gs, self.frame)
        screen.blit(gs, (sx, sy))
        self._d_hud()

    def _d_hud(self):
        hud = pygame.Surface((WIDTH, 52), pygame.SRCALPHA)
        hud.fill((8, 8, 16, 200))
        screen.blit(hud, (0, 0))
        txt_c(screen, self.question, FONT_MD, GOLD, 27)
        st = FONT_HUD.render(f"Time: {self.elapsed_ms / 1000.0:.2f}s", True, WHITE)
        screen.blit(st, (14, 6))
        lt = FONT_XS.render(f"Question Set: {self.n_prob}", True, GREY)
        screen.blit(lt, (14, 30))
        pt = FONT_HUD.render(f"{self.solved}/{self.n_prob}", True, WHITE)
        screen.blit(pt, (WIDTH - 55, 6))
        sl = FONT_XS.render("solved", True, GREY)
        screen.blit(sl, (WIDTH - 55, 28))
        for i in range(3):
            hx = WIDTH - 130 + i * 24
            hy = 16
            c = RED if i < self.lives else GREY_DIM
            pygame.draw.circle(screen, c, (hx - 4, hy), 6)
            pygame.draw.circle(screen, c, (hx + 4, hy), 6)
            pygame.draw.polygon(screen, c, [(hx - 10, hy + 2), (hx, hy + 14), (hx + 10, hy + 2)])
        if self.flash_t > 0:
            af = min(1.0, self.flash_t / 20)
            c = tuple(int(ch * af) for ch in self.flash_col)
            txt_c(screen, self.flash_txt, FONT_MD, c, 72)

    def _d_lvl_done(self):
        txt_sh(screen, "LEVEL COMPLETE!", FONT_LG, GREEN, 180)
        txt_sh(screen, f"Final Time: {self.elapsed_ms / 1000.0:.2f}s", FONT_MD, WHITE, 240)
        txt_sh(screen, "Single-level 15-question run complete", FONT_XS, GREY, 280)
        for i in range(self.lives):
            draw_star(screen, WIDTH // 2 - self.lives * 18 + i * 36 + 18, 340, 14, GOLD)
        for p in g_parts:
            p.draw(screen)

    def _d_over(self):
        txt_sh(screen, "GAME OVER", FONT_LG, RED, 180)
        txt_sh(screen, f"Time: {self.elapsed_ms / 1000.0:.2f}s  (DNF)", FONT_MD, WHITE, 240)
        lv = LEVELS[min(self.lvl, len(LEVELS) - 1)]
        txt_c(screen, f"Reached: Level {self.lvl + 1} - {lv['name']}", FONT_SM, GREY, 290)
        secs = max(1, self.show_timer // 60 + 1)
        txt_c(screen, f"Name entry in {secs}s... (or press SPACE)", FONT_XS, GREY_DIM, 340)

    def _d_win(self):
        txt_sh(screen, "YOU WIN!", FONT_XL, GOLD, 150)
        txt_sh(screen, f"Final Time: {self.elapsed_ms / 1000.0:.2f}s", FONT_LG, WHITE, 230)
        for i in range(5):
            draw_star(screen, WIDTH // 2 - 100 + i * 50, 295, 16, GOLD)
        txt_sh(screen, "Math Master!", FONT_MD, GREEN, 345)
        secs = max(1, self.show_timer // 60 + 1)
        txt_c(screen, f"Name entry in {secs}s... (or press SPACE)", FONT_XS, GREY_DIM, 400)
        for p in g_parts:
            p.draw(screen)

    def _d_name(self):
        if self.came_from_win:
            txt_sh(screen, "CONGRATULATIONS!", FONT_LG, GOLD, 80)
        else:
            txt_sh(screen, "GAME OVER", FONT_LG, RED, 80)
        if self.final_dnf:
            txt_sh(screen, f"Time: {self.final_time:.2f}s (DNF)", FONT_MD, WHITE, 130)
        else:
            txt_sh(screen, f"Time: {self.final_time:.2f}s", FONT_MD, WHITE, 130)
        txt_sh(screen, "Enter Your Name:", FONT_MD, CYAN, 190)
        # Input box
        bw, bh = 340, 50
        bx = WIDTH // 2 - bw // 2
        by = 218
        pygame.draw.rect(screen, INPUT_BG, (bx, by, bw, bh), border_radius=8)
        pygame.draw.rect(screen, PANEL_BORDER, (bx, by, bw, bh), 2, border_radius=8)
        nt = FONT_INPUT.render(self.name_input, True, WHITE)
        tx = bx + 16
        ty = by + bh // 2 - nt.get_height() // 2
        screen.blit(nt, (tx, ty))
        # Cursor blink
        if (self.frame // 30) % 2 == 0:
            cur_x = tx + nt.get_width() + 2
            pygame.draw.rect(screen, CURSOR_COL, (cur_x, ty + 2, 3, nt.get_height() - 4))
        cc = FONT_XS.render(f"{len(self.name_input)}/{self.name_max}", True, GREY)
        screen.blit(cc, (bx + bw - cc.get_width() - 8, by + bh + 5))
        txt_c(screen, "Press ENTER to submit", FONT_SM, GOLD, 315)
        txt_c(screen, "(Leave blank for 'ANON')", FONT_XS, GREY_DIM, 340)

    def _d_lb(self):
        if self.came_from_win:
            txt_sh(screen, "TIME TRIAL COMPLETE!", FONT_LG, GOLD, 48)
        else:
            txt_sh(screen, "FINAL RESULTS", FONT_LG, CYAN, 48)
        if self.final_dnf:
            txt_sh(screen, f"Time: {self.final_time:.2f}s (DNF)", FONT_MD, WHITE, 88)
        else:
            txt_sh(screen, f"Time: {self.final_time:.2f}s", FONT_MD, WHITE, 88)
        if self.lb_is_high:
            t = self.frame * 0.08
            r = int(200 + 55 * math.sin(t))
            g = int(200 + 55 * math.sin(t + 2))
            b = int(200 + 55 * math.sin(t + 4))
            txt_sh(screen, "NEW BEST TIME!", FONT_MD, (r, g, b), 120)
        hl_name = self.name_input.strip() or "ANON"
        draw_lb_panel(screen, self.lb_board, WIDTH // 2, 145,
                      title="LEADERBOARD", hl_name=hl_name, hl_score=round(self.final_time, 2),
                      pw=400, rh=24)
        pulse = int(180 + 60 * math.sin(self.frame * 0.05))
        txt_c(screen, "Press SPACE or ENTER for menu", FONT_SM,
              (pulse, pulse, min(255, pulse)), 510)


