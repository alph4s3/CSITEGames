def _synth(freq, ms, vol=0.12):
    if not SND_ON:
        return None
    try:
        sr = 22050
        n = int(sr * ms / 1000)
        buf = bytearray(n * 2)
        amp = int(32767 * vol)
        for i in range(n):
            decay = max(0.0, 1.0 - i / n * 0.6)
            v = int(amp * decay * math.sin(2 * math.pi * freq * i / sr))
            v = max(-32768, min(32767, v))
            buf[2 * i] = v & 0xFF
            buf[2 * i + 1] = (v >> 8) & 0xFF
        return pygame.mixer.Sound(buffer=bytes(buf))
    except Exception:
        return None


